# apps/api/.env.example
# Copy to .env and fill in your values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cashbook"

# Auth
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="15m"

# Server
PORT=3000
NODE_ENV=development
# Exact web origins; native apps do not need CORS.
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Cloudflare R2 (bill image storage)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="cashbook-bills"
R2_PUBLIC_URL="https://bills.your-domain.com"

# Google Cloud Vision (OCR)
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="./gcp-credentials.json"

# Optional: server-side AI insight prioritization. Disabled when either value is empty.
# Use a model supporting Chat Completions structured JSON outputs.
OPENAI_API_KEY=""
OPENAI_MODEL=""
