{
  "name": "cashbook-api",
  "version": "1.0.0",
  "description": "CashBook REST API — Fastify + Prisma + PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@google-cloud/vision": "^6.0.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.3",
    "pdfmake": "^0.2.10",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "write-excel-file": "^4.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@types/pdfmake": "^0.2.9",
    "prisma": "^5.22.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
