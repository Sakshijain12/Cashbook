// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  books      Book[]
  categories Category[]
  entries    Entry[]
  transfers  Transfer[]
  reports    Report[]

  @@map("users")
}

model Book {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String
  type       BookType
  color      String
  icon       String
  currency   String   @default("JPY")
  isArchived Boolean  @default(false) @map("is_archived")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries           Entry[]
  transfersFrom     Transfer[] @relation("TransferFromBook")
  transfersTo       Transfer[] @relation("TransferToBook")
  categoriesFrom    Category[] @relation("CategoryFromBook")
  categoriesTo      Category[] @relation("CategoryToBook")

  @@map("books")
}

enum BookType {
  cash
  bank
  credit
  prepaid
  forex
}

model Category {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  name           String
  entryType      EntryType   @map("entry_type")
  isTransfer     Boolean     @default(false) @map("is_transfer")
  fromBookId     String?     @map("from_book_id")
  toBookId       String?     @map("to_book_id")
  color          String?
  icon           String?
  isSystem       Boolean     @default(false) @map("is_system")
  createdAt      DateTime    @default(now()) @map("created_at")

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromBook   Book?   @relation("CategoryFromBook", fields: [fromBookId], references: [id])
  toBook     Book?   @relation("CategoryToBook", fields: [toBookId], references: [id])
  entries    Entry[]

  @@map("categories")
}

enum EntryType {
  INCOME
  EXPENSE
}

model Entry {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  bookId        String      @map("book_id")
  categoryId    String      @map("category_id")
  type          LedgerType
  amount        Decimal     @db.Decimal(12, 2)
  name          String
  paymentMethod String?     @map("payment_method")
  entryDate     DateTime    @map("entry_date") @db.Date
  entryTime     DateTime    @map("entry_time") @db.Time
  transferId    String?     @map("transfer_id")
  billUrl       String?     @map("bill_url")
  billThumbUrl  String?     @map("bill_thumb_url")
  note          String?
  deletedAt     DateTime?   @map("deleted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book      @relation(fields: [bookId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  transfer Transfer? @relation(fields: [transferId], references: [id])

  @@index([userId, deletedAt, entryDate])
  @@index([userId, bookId, deletedAt, entryDate])
  @@index([transferId])
  @@map("entries")
}

enum LedgerType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
}

model Transfer {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  fromBookId   String   @map("from_book_id")
  toBookId     String   @map("to_book_id")
  amount       Decimal  @db.Decimal(12, 2)
  entryFromId  String?  @map("entry_from_id")
  entryToId    String?  @map("entry_to_id")
  transferDate DateTime @map("transfer_date") @db.Date
  transferTime DateTime @map("transfer_time") @db.Time
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromBook Book    @relation("TransferFromBook", fields: [fromBookId], references: [id])
  toBook   Book    @relation("TransferToBook", fields: [toBookId], references: [id])
  entries  Entry[]

  @@map("transfers")
}

model Report {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  format      String   // pdf | xlsx
  fileUrl     String   @map("file_url")
  fileSizeKb  Int      @map("file_size_kb")
  dateFrom    DateTime @map("date_from") @db.Date
  dateTo      DateTime @map("date_to") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reports")
}
