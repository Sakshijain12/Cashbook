# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment variables & secrets (CRITICAL: Never commit passwords or credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
**/.env.local
!**/.env.example
!**/.env.template

