**/uploads/*
!**/uploads/.gitkeep
apps/api/uploads/*
!apps/api/uploads/.gitkeep
apps/api/uploads/bills/*
!apps/api/uploads/bills/.gitkeep
apps/api/uploads/reports/*
!apps/api/uploads/reports/.gitkeep

